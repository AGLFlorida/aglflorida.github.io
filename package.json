{
  "name": "aglflorida.github.io",
  "version": "0.29.19",
  "private": true,
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest --no-watchman",
    "compile": "npx tsc --noEmit",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "check:unicode": "tsx scripts/check-unicode.ts",
    "check:dupes": "jscpd src",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "verify:dev": "npm run lint && npm run test && npm run compile && npm run validate:schemas && npm run check:unicode && npm run check:dupes && npm run test:e2e"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-google-recaptcha": "^3.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@jest/transform": "^30.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "baseline-browser-mapping": "^2.11.33",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jscpd": "^5.3.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "overrides": {
    "glob": "^13.0.6",
    "rimraf": "^4",
    "get-uri": {
      "basic-ftp": "^5.2.2"
    },
    "tmp": "^0.2.4",
    "postcss-selector-parser": ">=7.1.6"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
